ZION_ME_URL=https://api.ziongroup.net/api/auth/v3_0/me
ZION_VALIDATE_URL=https://api.ziongroup.net/api/auth/v1_0/validate
ZION_REDIRECT_URI=https://your-domain.voss.kr/api/auth/zion-login/callback

# 앱 기본 URL
NEXT_PUBLIC_BASE_URL=https://your-domain.voss.kr
