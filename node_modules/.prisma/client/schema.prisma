generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("VPG_DATABASE_URL")
}

// 교회
model Church {
  id        String   @id @default(cuid())
  code      String   @unique // gwangju, mokpo, yeosu, suncheon, songha, gwangyang, haenam, naju
  name      String // 광주, 목포, 여수, 순천, 송하, 광양, 해남, 나주
  order     Int
  createdAt DateTime @default(now())

  users            User[]
  checklistItems   ChecklistItem[]
  checklistResults ChecklistResult[]
}

// 사용자 (Zion 기반)
model User {
  id        String   @id @default(cuid())
  zionNewNo String   @unique // Zion NEW_NO (13자리)
  name      String
  role      String   @default("member") // member, manager, admin
  churchId  String?
  church    Church?  @relation(fields: [churchId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 중점사항 (4개 고정 - 시드)
model FocusArea {
  id    Int    @id @default(autoincrement())
  code  String @unique // event_support, org_operation, vehicle_mgmt, church_support
  name  String // 행사시 교통업무 지원, ...
  order Int

  checklistItems ChecklistItem[]
}

// 월간 추진 리스트 항목 (교회별, 월별, 자유 작성)
model ChecklistItem {
  id          String    @id @default(cuid())
  churchId    String
  church      Church    @relation(fields: [churchId], references: [id])
  focusAreaId Int
  focusArea   FocusArea @relation(fields: [focusAreaId], references: [id])
  year        Int
  month       Int // 1~12
  title       String // 월간 추진 리스트 항목명
  targetDate  String? // 목표일자 (텍스트: "넷째주(28,월)" 등)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  result ChecklistResult?

  @@index([churchId, year, month])
}

// 달성 결과
model ChecklistResult {
  id       String        @id @default(cuid())
  itemId   String        @unique
  item     ChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  churchId String
  church   Church        @relation(fields: [churchId], references: [id])
  year     Int
  month    Int

  // 달성 여부
  isDone Boolean @default(false)

  // 달성 유형 (복수 선택 가능)
  achieveTypeSchedule  Boolean @default(false) // 계획준수
  achieveTypeIntensive Boolean @default(false) // 단기집중
  achieveTypeHabit     Boolean @default(false) // 습관기반
  achieveTypeRole      Boolean @default(false) // 역할분담

  // 미달성 유형 (1개 선택)
  failType String? // goal_error, no_plan, lack_execution, poor_mgmt, env_fail, communication

  // 미달성 세부 유형
  failDetailGoalVague       Boolean @default(false)
  failDetailGoalUnrealistic Boolean @default(false)
  failDetailGoalPriority    Boolean @default(false)
  failDetailNoSchedule      Boolean @default(false)
  failDetailNoStepPlan      Boolean @default(false)
  failDetailNoAssignee      Boolean @default(false)
  failDetailWorkCondition   Boolean @default(false)
  failDetailTimeShort       Boolean @default(false)
  failDetailNoRepeat        Boolean @default(false)
  failDetailLostMotivation  Boolean @default(false)
  failDetailPostpone        Boolean @default(false)
  failDetailNoMidCheck      Boolean @default(false)
  failDetailLateResponse    Boolean @default(false)
  failDetailNoData          Boolean @default(false)
  failDetailNoExternal      Boolean @default(false)
  failDetailNoRiskPlan      Boolean @default(false)
  failDetailNoResource      Boolean @default(false)
  failDetailRoleDup         Boolean @default(false)
  failDetailGap             Boolean @default(false)
  failDetailCollapse        Boolean @default(false)
  failDetailDelay           Boolean @default(false)

  note String? // 비고/특이사항

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([churchId, year, month])
}
